{
  "schema_version": 2,
  "id": "smart.progress-bar",
  "version": "1.0.0",
  "title": "Progress Bar",
  "summary": "Continuous determinate progress with normalized value, accessible range semantics and explicit semantic tone.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "progress-bar"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive",
    "determinate-progress",
    "accessible-range"
  ],
  "custom_element": "sf-progress-bar",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.progress-bar"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default"
      },
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/3",
          "1/2",
          "1",
          "2",
          "3"
        ]
      },
      "value": {
        "type": "string",
        "default": "0",
        "pattern": "^(?:100|[1-9]?[0-9])(?:\\.[0-9]+)?$"
      },
      "text-position": {
        "type": "string",
        "default": "none",
        "enum": [
          "none",
          "inline-end",
          "bottom",
          "right"
        ]
      },
      "status": {
        "type": "string",
        "default": "neutral",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ],
        "description": "What the progress reports, in the shared status vocabulary. The word this component used before, primary, is still accepted and means neutral."
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "value-text": {
        "type": "string",
        "default": ""
      },
      "tone": {
        "type": "string",
        "default": "neutral",
        "description": "Legacy name for status, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "getProgress": {
      "summary": "Returns the value attribute as a number (0 when absent); it is not clamped.",
      "arguments": [],
      "returns": {
        "type": "number"
      }
    },
    "setProgress": {
      "summary": "Sets the value attribute; null or undefined removes it.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "number|string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setTextPosition": {
      "summary": "Sets text-position; null or undefined removes it.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {},
  "state": {
    "machines": {
      "progress": [
        "active",
        "complete",
        "error"
      ]
    },
    "visual_states": [
      "default"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention",
      "running, cancelling or retrying the task",
      "inferring success, warning or error from the numeric percentage",
      "inventing the accessible process label"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "progressbar",
    "accessible_name": "required",
    "keyboard": [],
    "focus": "Progress Bar is not interactive and never enters the focus order."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
