  "methods": {
    "getInputElement": {
      "summary": "Returns the inner native input (.sf-radio-button input[type=\"radio\"]), or null before render.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "setChecked": {
      "summary": "Sets the checked property and state of the inner input; does not dispatch change.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setDisabled": {
      "summary": "Sets or clears disabled on the host and the inner input.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setState": {
      "summary": "Applies checked and disabled (checking also refreshes the rest of the named group) to the inner input and reflects them to host attributes; before render it falls back to the base setState.",
      "arguments": [
        {
          "name": "nextState",
          "type": "object",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onChange": {
      "summary": "Adds a listener for the native change event that bubbles from the inner input.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onFocus": {
      "summary": "Adds a focusin listener on the host.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onBlur": {
      "summary": "Adds a focusout listener on the host.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {
