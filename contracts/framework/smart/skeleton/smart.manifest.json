      },
      "type": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "icon"
        ],
        "description": "type=\"icon\" marks a placeholder that stands in for an icon; it combines with any kind. Not a legacy name for kind (see contracts/public-api-axes.json), so it has no removal date."
      },
      "items": {
        "type": "string",
        "default": ""
