  "ai_guidance": {
    "use_when": "Use sf-page-header at the top of every admin page: it is the only place a page states its path, heading, count, favourite and main action once the admin top bar is gone.",
    "do_not": [
      "Do not keep favourites in the component; answer sf-page-header-star from the host",
      "Do not put totals in the menu; they belong here",
      "Do not style the heading yourself; it is the fourth heading step"
    ],
    "required_reads": [
