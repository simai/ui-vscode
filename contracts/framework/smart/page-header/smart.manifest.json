{
  "schema_version": 2,
  "id": "smart.page-header",
  "version": "1.0.0",
  "title": "Page header",
  "summary": "The head of an admin page: path, heading, count, favourite star, install mark and main action. Replaces the admin top bar together with sf-admin-menu.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "page-header",
    "admin",
    "navigation"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive",
    "i18n"
  ],
  "custom_element": "sf-page-header",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.badges",
      "smart.icon-buttons",
      "smart.icons"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "heading": {
        "type": "string",
        "default": "",
        "description": "The page heading."
      },
      "count": {
        "type": "string",
        "default": "",
        "description": "How many records the page holds; empty draws no count. The admin menu carries no totals, so this is where they are."
      },
      "level": {
        "type": "string",
        "default": "site",
        "enum": [
          "site",
          "install"
        ],
        "description": "install marks a page shared by every site."
      },
      "star": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "off",
          "on"
        ],
        "description": "Empty draws no star; off and on draw it in that state."
      },
      "root-class": {
        "type": "string",
        "default": ""
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {},
  "events": {
    "sf-page-header-star": {
      "summary": "The person pressed the star. Cancelable: a host that waits for its own answer cancels it and sets star itself.",
      "payload": {
        "type": "object",
        "required": [
          "on"
        ],
        "properties": {
          "on": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "state": {
    "machines": {},
    "visual_states": [
      "default",
      "selected"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention",
      "keeping favourites"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "banner content; the heading is an h1",
    "accessible_name": "internal",
    "keyboard": [
      "Tab reaches the star and the actions",
      "Enter or Space toggles the star"
    ],
    "focus": "The star is a native button in sf-icon-button with aria-pressed and a label that says what pressing it does."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "block",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
