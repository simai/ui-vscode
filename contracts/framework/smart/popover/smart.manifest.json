  "ai_guidance": {
    "use_when": "Use sf-popover for a surface anchored to a control the consumer supplies -- a field's settings, a filter, a list of things to add -- that opens on its trigger and closes on Escape or outside.",
    "do_not": [
      "Do not use it for a blocking task; that is sf-modal",
      "Do not write role on the host; use surface-role",
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component"
    ],
    "required_reads": [
      "inputs",
      "methods",
      "events",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<sf-popover label=\"Settings\"><button slot=\"trigger\" type=\"button\">Settings</button><div slot=\"content\">…</div></sf-popover>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
