        "sha256": "88d63d31d61879d048bc901a4a8173d3af9a96d5f3a4fd532eac2ab02ebf351c"
      },
      {
        "path": "src/smart/popover/js/templates/default.js",
        "sha256": "6f6be19ccafaacaa72e047dbbd0084c4a45738bed8ab1f5756e4833e9abec169"
