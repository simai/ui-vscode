  "contracts": {},
  "methods": {
    "getSlotHtml": {
      "summary": "Returns the HTML of the captured content for a named slot, with runtime data and event ids carried over.",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "required": true
        }
      ],
      "returns": {
        "type": "string"
      }
    },
    "open": {
      "summary": "Opens the window, or brings it to the front when already open. Dispatches modal:before-open (cancelable), then modal:after-open once projected; loads remote content when src is set. options.animate (or a boolean) controls the opening transition. Returns the element.",
      "arguments": [
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "close": {
      "summary": "Closes the window after modal:before-close (cancelable), runs the close transition, restores focus and dispatches modal:after-close. Returns the element.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "hide": {
      "summary": "Minimizes an open overlay window after modal:before-hide (cancelable) and dispatches modal:after-hide. Does nothing inline. Returns the element.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "show": {
      "summary": "Restores a minimized window after modal:before-show (cancelable) and dispatches modal:after-show. Returns the element.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "toggle": {
      "summary": "Calls close() when open, open() otherwise. Returns the element.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setSrc": {
      "summary": "Sets the src attribute, aborts and resets the current remote content and loads the new source when it may load now. Returns the element.",
      "arguments": [
        {
          "name": "src",
          "type": "string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "getModalRoot": {
      "summary": "Returns the rendered .sf-modal element, or null before render.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "onKeyDown": {
      "summary": "The document keydown handler the modal binds itself: Escape closes the top open window when close-on-esc allows it, Tab is trapped inside it. Not meant to be called by a host.",
      "arguments": [
        {
          "name": "event",
          "type": "KeyboardEvent",
          "required": true
        }
      ],
      "returns": {
        "type": "null",
        "description": "Returns nothing."
      }
    },
    "resetRemoteContent": {
      "summary": "Clears the loaded remote HTML, error and loading state and aborts a running request.",
      "arguments": [],
      "returns": {
        "type": "null",
        "description": "Returns nothing."
      }
    },
    "clearPortal": {
      "summary": "Unrenders and removes the portal root the window was projected into, if any.",
      "arguments": [],
      "returns": {
        "type": "null",
        "description": "Returns nothing."
      }
    },
    "onBeforeOpen": {
      "summary": "Adds a listener for modal:before-open on the host that runs only for this modal's own events. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
