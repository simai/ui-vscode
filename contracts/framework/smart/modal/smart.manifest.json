{
  "schema_version": 2,
  "id": "smart.modal",
  "version": "1.1.0",
  "title": "Modal",
  "summary": "A dialog window over the page in the shared modal stack: centered or at a side, top or bottom edge, with header, content and footer slots, focus trap, scroll lock and focus return. It can also be minimized, load its content by Ajax or into an iframe, or render inline in the page flow.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "modal"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-modal",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [],
    "public_parts": []
  },
