  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "status when announce is true and label is non-empty; otherwise no widget role",
    "accessible_name": "recommended",
    "keyboard": [],
    "focus": "Spinner is not interactive and never enters the focus order."
