{
  "schema_version": 2,
  "id": "smart.spinner",
  "version": "1.0.0",
  "title": "Spinner",
  "summary": "Indeterminate waiting indicator with arc or dots presentation, optional polite status announcement and Framework-owned motion.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "spinner"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive",
    "loading-status",
    "reduced-motion"
  ],
  "custom_element": "sf-spinner",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.spinner"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/2",
          "1",
          "2",
          "3"
        ]
      },
      "width": {
        "type": "string",
        "default": ""
      },
      "height": {
        "type": "string",
        "default": ""
      },
      "label": {
        "type": "string",
        "default": "",
        "description": "Empty: the text of the page's language (\"Loading...\" in English)."
      },
      "kind": {
        "type": "string",
        "default": "arc",
        "enum": [
          "arc",
          "dots"
        ],
        "description": "What the spinner is: an arc or a row of dots."
      },
      "dots": {
        "type": "string",
        "default": "16",
        "pattern": "^(?:[3-9]|[12][0-9]|3[0-2])$"
      },
      "filled": {
        "type": "string",
        "default": "6",
        "pattern": "^(?:[1-9]|[12][0-9]|3[0-2])$"
      },
      "stroke-width": {
        "type": "string",
        "default": ""
      },
      "dot-radius": {
        "type": "string",
        "default": ""
      },
      "infinite": {
        "type": "boolean",
        "default": false
      },
      "announce": {
        "type": "boolean",
        "default": false
      },
      "direction": {
        "type": "string",
        "default": "clockwise",
        "enum": [
          "clockwise",
          "counterclockwise"
        ]
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "variant": {
        "type": "string",
        "default": "arc",
        "description": "Legacy name for kind, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "arc",
          "dots"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "getSpinnerRoot": {
      "summary": "Returns the inner spinner root (.sf-loader-container), or null before render.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "refreshSpinner": {
      "summary": "Re-renders the bound spinner root from its current configuration; does nothing before it is bound.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {},
  "state": {
    "machines": {
      "waiting": [
        "active",
        "complete"
      ]
    },
    "visual_states": [
      "default",
      "active"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
