    "open": {
      "summary": "Moves to the given one-based slide when an index is passed, sets open and opens the lightbox modal. Returns the element.",
      "arguments": [
        {
          "name": "index",
          "type": "number",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "close": {
      "summary": "Removes open and closes the lightbox modal. Returns the element.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "toggle": {
      "summary": "Calls close() when open, open(index) otherwise. Returns the element.",
      "arguments": [
        {
          "name": "index",
          "type": "number",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "goTo": {
      "summary": "Moves to a one-based slide, clamped to the slide count, reflects it to the current attribute, syncs both sliders and dispatches sf-change when it moved. Returns the element.",
      "arguments": [
        {
          "name": "index",
          "type": "number",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "next": {
      "summary": "goTo(current + 1); stops at the last slide. Returns the element.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "prev": {
      "summary": "goTo(current - 1); stops at the first slide. Returns the element.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
