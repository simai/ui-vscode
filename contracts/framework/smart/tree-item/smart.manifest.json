          "value": {
            "type": "string"
          },
          "originalEvent": {
            "type": [
              "object",
              "null"
            ],
            "description": "The click; null when activated from the keyboard (Enter) on an item without a link."
          }
        },
        "required": [
          "component",
          "tagName",
          "template",
          "item",
          "value",
          "originalEvent"
        ]
      }
    },
    "sf-tree-item-toggle": {
      "summary": "Runtime event sf-tree-item-toggle.",
      "payload": {
        "type": "object",
        "properties": {
          "component": {
            "type": "object",
            "description": "The emitting element."
