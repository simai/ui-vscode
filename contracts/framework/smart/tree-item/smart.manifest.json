        "type": "string",
        "default": "folder",
        "description": "Legacy name for kind, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "folder",
          "file"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "setOpen": {
      "summary": "Opens or closes a branch and emits sf-tree-item-toggle; does nothing for a file, a leaf, a disabled item or an unchanged state.",
      "arguments": [
        {
          "name": "open",
          "type": "boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "open": {
      "summary": "Same as setOpen(true).",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "close": {
      "summary": "Same as setOpen(false).",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "focusItem": {
      "summary": "Moves DOM focus to this tree item.",
      "arguments": [],
      "returns": {
        "type": [
          "object"
        ]
      }
    },
    "activate": {
      "summary": "Activates the item link or emits the item click event.",
      "arguments": [],
      "returns": {
        "type": [
          "object"
        ]
      }
    },
    "toggle": {
      "summary": "Flips the open state through setOpen.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onToggle": {
      "summary": "Adds a listener for sf-tree-item-toggle; the handler is called with (open, detail, event). Ignores a non-function handler.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {
    "sf-tree-item-click": {
      "summary": "Runtime event sf-tree-item-click.",
      "payload": {
        "type": "object",
        "properties": {
          "component": {
            "type": "object",
