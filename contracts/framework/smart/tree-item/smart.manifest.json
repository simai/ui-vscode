          "tagName": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "item": {
            "type": "object",
            "description": "The sf-tree-item."
          },
          "open": {
            "type": "boolean"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "component",
          "tagName",
          "template",
          "item",
          "open",
          "value"
        ]
      }
    }
