      "name": {
        "type": "string",
        "default": ""
      },
      "value": {
        "type": "string",
        "default": ""
      },
      "error": {
        "type": "boolean",
        "default": false,
        "description": "Invalid state; the native input publishes aria-invalid."
      },
      "aria-label": {
        "type": "string",
        "default": "",
        "description": "Accessible name for a checkbox rendered without a visible label."
      }
    },
    "additionalProperties": false
  },
