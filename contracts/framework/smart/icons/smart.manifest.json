  "ai_guidance": {
    "use_when": "Use sf-icon for a Material Symbol that must participate in the Framework Loader and token scale. Omit label when adjacent text or a named control already conveys the meaning; provide a concise label only for an informative standalone symbol.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component",
      "Do not make the icon focusable or use it as a control",
      "Do not label a decorative icon inside an already named control",
      "Do not use loaded as an authoring switch"
    ],
    "required_reads": [
      "inputs",
      "methods",
      "events",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<sf-icon icon=\"home\"></sf-icon>",
