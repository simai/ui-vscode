{
  "schema_version": 2,
  "id": "smart.icons",
  "version": "1.0.0",
  "title": "Icons",
  "summary": "Semantic Material Symbol wrapper with exact Loader tracking, accessible decorative or informative modes and token-owned geometry.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "icons"
  ],
  "capabilities": [
    "render",
    "accessible-name",
    "icon-families",
    "variable-axes",
    "dynamic-subset",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-icon",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.icons",
      "component.badges"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "icon": {
        "type": "string",
        "default": ""
      },
      "loaded": {
        "type": "boolean",
        "default": false
      },
      "filled": {
        "type": "boolean",
        "default": false
      },
      "weight": {
        "type": "number",
        "default": 400
      },
      "size": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "1/4",
          "1/3",
          "1/2",
          "1",
          "2",
          "3",
          "4",
          "5",
          "6",
          "7"
        ]
      },
      "type": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "outlined",
          "rounded",
          "sharp",
          "shape"
        ]
      },
      "grade": {
        "type": "number",
        "default": 0,
        "minimum": -50,
        "maximum": 200
      },
      "optical-size": {
        "type": "number",
        "default": 24,
        "minimum": 20,
        "maximum": 48
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "badge-count": {
        "type": "string",
        "default": "",
        "description": "A count on the icon (simai/ui-source#12): a whole number above 0 shows, 0 or empty hides the badge. Above badge-cap it reads «<cap>+»; the exact number joins the icon's accessible name («Почта, 3 непрочитанных») and the badge's tooltip. On an anchor of size 1/3 or 1/2 a count is drawn as a dot."
      },
      "badge-dot": {
        "type": "boolean",
        "default": false,
        "description": "A dot on the icon, a count with no number: something new. Shown when badge-count is not set; with a count, the count is drawn as a dot. Its text equivalent («есть новое» / «new» by default, badge-label to change it) joins the accessible name."
      },
      "badge-cap": {
        "type": "integer",
        "default": 99,
        "description": "The largest count drawn as a number; a larger one reads «<cap>+»."
      },
      "badge-label": {
        "type": "string",
        "default": "",
        "description": "The words the badge adds to the accessible name and its tooltip, in place of the page language's default: for a dot the whole text equivalent; for a count the phrase in plural forms separated by «|» (one|few|many in Russian, one|other in English) with {count} where the number goes."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {},
  "events": {},
  "state": {
    "machines": {},
    "visual_states": [
      "default"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "fixture",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "img when label is present; hidden when decorative",
    "accessible_name": "recommended",
    "keyboard": [],
    "focus": "The icon is not interactive and never enters the tab order. Name the containing control instead."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "inherited current color",
      "pre-upgrade reserved size"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke"
    ]
  },
  "compatibility": {
