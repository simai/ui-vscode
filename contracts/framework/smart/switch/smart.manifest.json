{
  "schema_version": 2,
  "id": "smart.switch",
  "version": "1.1.0",
  "title": "Switch",
  "summary": "An on/off control for a setting that applies at once: a native checkbox with role=\"switch\", a track and a moving thumb, with a label, description and help text.",
  "kind": "smart",
  "reuse_mode": "both",
  "lifecycle": "experimental",
  "tags": [
    "switch"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-switch",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.switch"
    ],
    "public_parts": [
      "native-input",
      "track",
      "thumb",
      "label",
      "description"
    ]
  },
  "inputs": {
    "type": "object",
    "properties": {
      "size": {
        "type": "string",
        "default": "1",
        "description": "Switch size token.",
        "enum": [
          "1/2",
          "1",
          "2"
        ]
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": ""
      },
      "help": {
        "type": "string",
        "default": ""
      },
      "checked": {
        "type": "boolean",
        "default": false
      },
      "disabled": {
        "type": "boolean",
        "default": false
      },
      "name": {
        "type": "string",
        "default": ""
      },
      "value": {
        "type": "string",
        "default": ""
      },
      "aria-label": {
        "type": "string",
        "default": "",
        "description": "Accessible name for a switch rendered without a visible label, as in a record panel that draws the label itself."
      },
      "inherited-value": {
        "type": "string",
        "default": "",
        "description": "Whether the switch is on while it holds no value of its own: true/on or false/off. The knob stands where it says, quieter, with an «inherited» marker, and the checkbox submits nothing. With it set, «off» chosen by a person is kept as checked=\"false\" -- a value of its own -- and no `checked` at all means the inherited state; a reset button returns there."
      },
      "inherited-text": {
        "type": "string",
        "default": "",
        "description": "The words of the marker shown while the inherited value applies. Unset, it follows the page's language («inherited», «наследуется»)."
      },
      "reset-label": {
        "type": "string",
        "default": "",
        "description": "The accessible name of the button that returns the field to the inherited value. Unset, it follows the page's language («Reset to inherited», «Сбросить к наследуемому»)."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "state_owner": {
      "const": "native_input"
    },
    "application": {
      "const": "immediate_binary_setting"
    },
    "reset": {
      "const": "native_form_reset"
    },
    "switch_states": {
      "type": "string",
      "enum": [
        "unchecked",
        "checked",
        "disabled"
      ]
    }
  },
  "methods": {
    "getInputElement": {
      "summary": "Returns the inner native input (.sf-switch input[type=\"checkbox\"]), or null before render.",
      "arguments": [],
      "returns": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "setChecked": {
      "summary": "Sets the checked property and state of the inner input; does not dispatch change.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setDisabled": {
      "summary": "Sets or clears disabled on the host and the inner input.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setState": {
      "summary": "Applies checked and disabled to the inner input and reflects them to host attributes; before render it falls back to the base setState.",
      "arguments": [
        {
          "name": "nextState",
          "type": "object",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onChange": {
      "summary": "Adds a listener for the native change event that bubbles from the inner input.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onFocus": {
      "summary": "Adds a focusin listener on the host.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onBlur": {
      "summary": "Adds a focusout listener on the host.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "resetToInherited": {
      "summary": "Returns the field to its inherited value, as the reset button does: fires the cancellable sf-field:reset, then empties the own value and focuses the control. Returns whether it was reset (false without an inherited value, without an own value, while disabled or readonly, or when the event was prevented).",
      "arguments": [],
      "returns": {
        "type": "boolean",
        "description": "Whether the field was reset."
      }
    }
  },
  "events": {
    "change": {
      "summary": "The on state changed; the native event bubbles from the inner checkbox, which is its target.",
      "payload": {
        "type": "object"
      },
      "canonical": true
    },
    "sf-field:reset": {
      "summary": "The person pressed the reset back to the inherited value. Fired before the field is emptied and cancellable: preventDefault keeps the value. When it is not prevented the field empties, says so with its ordinary change, shows the inherited value again and takes focus back.",
      "payload": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The field's own value before the reset."
          },
          "inheritedValue": {
            "type": "string",
            "description": "The inherited value it returns to."
          },
          "name": {
            "type": "string",
            "description": "The form name, empty when the field has none."
          }
        }
      }
    }
  },
  "state": {
    "machines": {},
    "visual_states": [
      "default",
      "selected",
      "disabled"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "fixture",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "switch",
    "accessible_name": "required",
    "keyboard": [
      "Tab",
      "Space"
    ],
    "focus": "Keep visible focus on the active control. After a reset back to the inherited value, focus returns to the control; while the value is inherited, the control carries it as aria-description and the visible marker is aria-hidden."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
