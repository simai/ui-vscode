{
  "schema_version": 2,
  "id": "smart.progress-scale",
  "version": "1.0.0",
  "title": "Progress Scale",
  "summary": "Segmented determinate progress with exact accessible value, explicit semantic tone and ten visual steps.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "progress-scale"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive",
    "determinate-progress",
    "accessible-range"
  ],
  "custom_element": "sf-progress-scale",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.progress-scale"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default"
      },
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/3",
          "1/2",
          "1",
          "2",
          "3"
        ]
      },
      "line": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "1/2",
          "1",
          "2"
        ],
        "description": "Takes the text line of this form size, for a table cell or a row of fields, so the row keeps its control height."
      },
      "value": {
        "type": "string",
        "default": "0",
        "pattern": "^(?:100|[1-9]?[0-9])(?:\\.[0-9]+)?$"
      },
      "show-text": {
        "type": "boolean",
        "default": true
      },
      "status": {
        "type": "string",
        "default": "neutral",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ],
        "description": "What the progress reports, in the shared status vocabulary. The word this component used before, primary, is still accepted and means neutral."
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "value-text": {
        "type": "string",
        "default": ""
      },
      "tone": {
        "type": "string",
        "default": "neutral",
        "description": "Legacy name for status, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "getProgress": {
      "summary": "Returns the value as a number clamped to 0..100; a non-numeric value reads as 0.",
      "arguments": [],
      "returns": {
        "type": "number"
      }
    },
    "setProgress": {
      "summary": "Sets the value attribute; null or undefined removes it.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "number|string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {},
  "state": {
    "machines": {
      "progress": [
        "active",
        "complete",
        "error"
      ]
    },
    "visual_states": [
      "default"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention",
      "running, cancelling or retrying the task",
      "inferring semantic state from the current segment count",
      "inventing the accessible process label"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "progressbar",
    "accessible_name": "required",
    "keyboard": [],
    "focus": "Progress Scale is not interactive and never enters the focus order."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
