          },
          "item": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "disabled": {
                "type": "boolean"
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "disabled": {
                  "type": "boolean"
                }
              }
            }
