  },
  "item_contract": {},
  "contracts": {},
  "methods": {
    "setState": {
      "summary": "Writes each key as its kebab-case attribute; an array (items) is serialised as label::disabled entries joined by |. false, null, undefined or empty removes the attribute, true sets it empty.",
      "arguments": [
        {
          "name": "nextState",
          "type": "object",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "goToStep": {
      "summary": "Moves current to the step at index, clamped to the list; does nothing for a disabled or the current step. Emits sf-step-change.",
      "arguments": [
        {
          "name": "index",
          "type": "number|string",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onStepChange": {
      "summary": "Adds a listener for sf-step-change; the handler is called with (current, detail, event). Ignores a non-function handler.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": "object|boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {
    "sf-step-change": {
      "summary": "Runtime event sf-step-change.",
      "payload": {
        "type": "object",
        "properties": {
          "component": {
            "type": "object",
            "description": "The emitting element."
          },
          "tagName": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "previous": {
