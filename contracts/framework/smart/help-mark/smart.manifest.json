{
  "schema_version": 2,
  "id": "smart.help-mark",
  "version": "1.0.0",
  "title": "Help mark",
  "summary": "A «?» beside a label that opens a short explanation on a press -- a toggletip -- announced politely, closed by Escape, a second press or a click outside.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "help",
    "toggletip",
    "popover"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "responsive"
  ],
  "custom_element": "sf-help-mark",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.icon-buttons",
      "smart.icons"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "default": "",
        "description": "The explanation; slot `content` takes links or lists instead."
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "label": {
        "type": "string",
        "default": "",
        "description": "The button's accessible name; «Подробнее» / More information by default, best naming the subject («Подробнее: код решения»)."
      },
      "size": {
        "type": "string",
        "enum": [
          "1/3",
          "1/2",
          "1"
        ],
        "default": "1/2"
      },
      "placement": {
        "type": "string",
        "enum": [
          "auto",
          "top",
          "bottom",
          "start",
          "end"
        ],
        "default": "auto"
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "template": {
        "type": "string",
        "default": "default"
      }
    },
    "additionalProperties": false
  },
  "contracts": {},
  "methods": {
    "open": {
      "summary": "Opens the explanation.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "A promise."
      }
    },
    "close": {
      "summary": "Closes it.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "Nothing."
      }
    }
  },
  "events": {
    "sf-help-mark-open": {
      "summary": "The explanation opened.",
      "payload": {
        "type": "object",
        "properties": {}
      }
    },
    "sf-help-mark-close": {
      "summary": "The explanation closed.",
      "payload": {
        "type": "object",
        "properties": {}
      }
    }
  },
  "state": {
    "machines": {
      "panel": [
        "closed",
        "open"
      ]
    },
    "visual_states": [
      "default",
      "open"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "saving the width on a server"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "button",
    "accessible_name": "recommended",
    "keyboard": [
      "Enter",
      "Space",
      "Escape",
      "Tab"
    ],
    "focus": "A button with aria-expanded and aria-controls; a press opens the explanation and it is announced in a polite status. Escape, a second press or a click outside close it and focus stays on the button. An explanation holding a link or control follows the button in the focus order and closes when focus leaves both."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "ltr",
      "rtl",
      "reduced-motion"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
