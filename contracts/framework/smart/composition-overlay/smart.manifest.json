  },
  "ai_guidance": {
    "use_when": "Use sf-composition-overlay on an editor page over SF.Composition.render output. Treat every event as intent: the host changes the Document, saves it with an expected revision, validates and re-renders.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not write editor markup into the canvas HTML",
      "Do not treat setDropFilter as validation; Document validation stays authoritative",
      "Do not put the overlay after the canvas in Tab order"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "methods",
      "events",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<sf-composition-overlay id=\"overlay\" for=\"canvas\" accepts=\"blocks\"></sf-composition-overlay><div id=\"canvas\"></div>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
