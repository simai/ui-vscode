{
  "schema_version": 2,
  "id": "smart.composition-overlay",
  "version": "1.0.0",
  "title": "Composition overlay",
  "summary": "Editor chrome over a rendered Composition Document: frames, labels, badges, action toolbar, insertion places, drag and keyboard moves and a keyboard tree, without changing the canvas HTML.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "composition",
    "editor",
    "overlay"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "responsive",
    "theme"
  ],
  "custom_element": "sf-composition-overlay",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.sortable"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "for": {
        "type": "string",
        "default": "",
        "description": "id of the canvas element that holds SF.Composition.render output"
      },
      "accepts": {
        "type": "string",
        "default": "",
        "description": "sf-sortable groups whose items may be dropped on insertion places"
      },
      "label": {
        "type": "string",
        "default": ""
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "canvas": {
      "type": "object",
      "description": "The canvas holds host-rendered Composition HTML with data-sf-composition-id; the overlay never writes into it, so published HTML and digests are identical with the editor open or closed. Place the overlay before the canvas so its tree comes first in Tab order."
    },
    "actions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "browser_api": {
      "type": "object",
      "description": "Once loaded, SF.CompositionOverlay exposes OVERLAY_EVENTS, overlayNodes(document) and checkOverlayActions(actions)."
    }
  },
  "methods": {
    "attach": {
      "summary": "Binds the overlay to a canvas element.",
      "arguments": [
        {
          "name": "canvas",
          "type": "Element"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setDocument": {
      "summary": "Sets the Document and describe(node) → {label, badges}.",
      "arguments": [
        {
          "name": "document",
          "type": "object"
        },
        {
          "name": "options",
          "type": "object"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setActions": {
      "summary": "Sets toolbar actions {id, label}.",
      "arguments": [
        {
          "name": "actions",
          "type": "array"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setMessages": {
      "summary": "Overrides interface texts.",
      "arguments": [
        {
          "name": "messages",
          "type": "object"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setDropFilter": {
      "summary": "Hides drop places the host would refuse: (place, item) => boolean.",
      "arguments": [
        {
          "name": "filter",
          "type": "function"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "setInsertionTarget": {
      "summary": "Marks an insertion place or clears it with null.",
      "arguments": [
        {
          "name": "target",
          "type": [
            "object",
            "null"
          ]
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    },
    "select": {
      "summary": "Selects a node by id.",
      "arguments": [
        {
          "name": "id",
          "type": [
            "string",
            "null"
          ]
        },
        {
          "name": "options",
          "type": "object"
        }
      ],
      "returns": {
        "type": [
          "object",
          "boolean",
          "null"
        ]
      }
    }
  },
  "events": {
    "sf-composition-overlay-select": {
      "summary": "A node was selected.",
      "payload": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "sf-composition-overlay-action": {
      "summary": "A toolbar action was chosen.",
      "payload": {
        "type": "object",
        "required": [
          "action_id",
          "node_id"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          }
        }
      }
    },
    "sf-composition-overlay-insert": {
      "summary": "Insertion was requested at a place, optionally with a library item.",
      "payload": {
        "type": "object",
        "required": [
          "parent_id",
          "slot",
          "index"
        ],
        "properties": {
          "parent_id": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          },
          "item": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "move",
              "copy"
            ]
          }
        }
      }
    },
    "sf-composition-overlay-move": {
      "summary": "A canvas node was moved to a place.",
      "payload": {
        "type": "object",
        "required": [
          "node_id",
          "parent_id",
          "slot",
          "index"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          }
        }
      }
    }
  },
  "state": {
    "machines": {
      "move": [
        "idle",
        "picking",
        "dropped",
        "cancelled"
      ]
    },
    "visual_states": [
      "default",
      "selected",
      "active"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention",
      "saving or reordering host data"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "tree",
    "accessible_name": "recommended",
    "keyboard": [
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight",
      "Home",
      "End",
      "Enter",
      "Space",
      "Escape"
    ],
    "focus": "The tree has one treeitem per node; arrows move in document order and between parent and child, Enter opens the toolbar, Escape returns or clears. Space starts a keyboard move, arrows choose a place, Enter drops, Escape cancels. Selection and moves are announced."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "ltr",
      "rtl",
      "reduced-motion"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "runnable",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke",
      "keyboard",
      "responsive",
      "a11y"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "094f3d549aa7921d2d7f8773972c73711dd6a72e",
      "ui_smart_revision": "856fb5d751fad1c76104c32515f4c1869dd75b6c"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": []
  },
  "provenance": {
    "source_repository": "simai/ui-source",
    "source_revision": "d73527c92056a684b5f34a46ec7315e1ded9be19",
    "source_artifacts": [
      {
        "path": "src/smart/composition-overlay/index.js",
        "sha256": "10d9d65a7d0d3e09837e035ec3a88ed881f7bd502463de7b8e9ca62543aaa7bf"
      },
      {
        "path": "src/smart/composition-overlay/scss/_smart__composition-overlay.scss",
        "sha256": "cd1f2c00674a77cd820417a4f7577640eb572ac6ad3bd61e529abff3c792c6d0"
      },
      {
