  "ai_guidance": {
    "use_when": "Use sf-textarea for comments, descriptions and other free text that may contain multiple lines and must participate in a native form.",
    "do_not": [
      "Do not use Textarea for short single-line values, rich text or code editing",
      "Do not enable horizontal resizing inside responsive layouts without an explicit layout decision",
      "Do not put Enter-to-send into the textarea: in a form Enter is a newline; a chat composer handles it itself",
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component"
    ],
    "required_reads": [
      "inputs",
      "methods",
      "events",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<sf-textarea label=\"Comment\" name=\"comment\" rows=\"4\" maxlength=\"500\"></sf-textarea>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
