{
  "schema_version": 2,
  "id": "smart.textarea",
  "version": "1.4.0",
  "title": "Textarea",
  "summary": "A native multiline form control with Framework presentation, validation messaging and safe vertical resizing.",
  "kind": "smart",
  "reuse_mode": "both",
  "lifecycle": "experimental",
  "tags": [
    "textarea"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-textarea",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.textarea"
    ],
    "public_parts": [
      "native-textarea",
      "label",
      "hint"
    ]
  },
  "inputs": {
    "type": "object",
    "properties": {
      "size": {
        "type": "string",
        "default": "1",
        "enum": [
          "1/2",
          "1",
          "2"
        ]
      },
      "appearance": {
        "type": "string",
        "default": "bordered",
        "enum": [
          "bordered",
          "filled",
          "flush"
        ],
        "description": "How the field looks: a bordered box, a filled one, or flush -- no box of its own, inside a composite control that draws the box and the focus."
      },
      "label": {
        "type": "string",
        "default": ""
      },
      "required": {
        "type": "boolean",
        "default": false
      },
      "placeholder": {
        "type": "string",
        "default": ""
      },
      "autocomplete": {
        "type": "string",
        "default": ""
      },
      "inputmode": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "none",
          "text",
          "tel",
          "url",
          "email",
          "numeric",
          "decimal",
          "search"
        ]
      },
      "minlength": {
        "type": "number",
        "default": null
      },
      "maxlength": {
        "type": "number",
        "default": null
      },
      "spellcheck": {
        "type": "boolean",
        "default": true
      },
      "wrap": {
        "type": "string",
        "default": "soft",
        "enum": [
          "soft",
          "hard"
        ]
      },
      "hint": {
        "type": "string",
        "default": ""
      },
      "value": {
        "type": "string",
        "default": ""
      },
      "name": {
        "type": "string",
        "default": ""
      },
      "rows": {
        "type": "number",
        "default": 3
      },
      "auto-grow": {
        "type": "boolean",
        "default": false,
        "description": "The field follows its text between min-rows and max-rows and scrolls inside past max-rows. CSS field-sizing where supported, a script fallback elsewhere; rows is then ignored."
      },
      "min-rows": {
        "type": "number",
        "default": 1,
        "description": "With auto-grow: the fewest rows the field shows. One row is the height of an input of the same size."
      },
      "max-rows": {
        "type": "number",
        "default": null,
        "description": "With auto-grow: the most rows before the field scrolls inside. Unset means no cap; a value below min-rows is min-rows."
      },
      "disabled": {
        "type": "boolean",
        "default": false
      },
      "readonly": {
        "type": "boolean",
        "default": false
      },
      "error": {
        "type": "boolean",
        "default": false
      },
      "invalid": {
        "type": "boolean",
        "default": false
      },
      "error-message": {
        "type": "string",
        "default": ""
      },
      "mask": {
        "type": "boolean",
        "default": false
      },
      "mask-pattern": {
        "type": "string",
        "default": ""
      },
      "mask-options": {
        "type": "string",
        "default": ""
      },
      "type": {
        "type": "string",
        "default": "bordered",
        "description": "Legacy name for appearance, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "bordered",
          "filled",
          "flush"
        ]
      },
      "inherited-value": {
        "type": "string",
        "default": "",
        "description": "What the field falls back to while it holds no value of its own. Shown as inherited, in the placeholder's ink with an «inherited» marker under the field, never as the value: the form value stays empty. Once the field holds a value of its own, a reset button returns it here."
      },
      "inherited-text": {
        "type": "string",
        "default": "",
        "description": "The words of the marker shown while the inherited value applies. Unset, it follows the page's language («inherited», «наследуется»)."
      },
      "reset-label": {
        "type": "string",
        "default": "",
        "description": "The accessible name of the button that returns the field to the inherited value. Unset, it follows the page's language («Reset to inherited», «Сбросить к наследуемому»)."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "state_owner": {
      "const": "native_textarea"
    },
    "value_owner": {
      "const": "native_textarea"
    },
    "form_owner": {
      "const": "native_form"
    },
    "reset": {
      "const": "native_form_reset"
    },
    "resize_default": {
      "const": "vertical"
    },
    "auto_grow": {
      "const": "field_sizing_content_with_script_fallback"
    },
    "mask_owner": {
      "const": "optional_sf_mask_adapter"
    },
    "field_states": {
      "type": "string",
      "enum": [
        "empty",
        "filled",
        "hover",
        "focus-visible",
        "readonly",
        "disabled",
        "invalid"
      ]
    }
  },
  "methods": {
    "setState": {
      "summary": "Applies disabled, error or invalid, errorMessage and value to the inner textarea and resyncs its field semantics; setting value dispatches input. Returns false when the textarea is not rendered.",
      "arguments": [
        {
          "name": "nextState",
          "type": "object",
          "required": true
        }
      ],
      "returns": {
        "type": "boolean"
      }
    },
    "resetToInherited": {
      "summary": "Returns the field to its inherited value, as the reset button does: fires the cancellable sf-field:reset, then empties the own value and focuses the control. Returns whether it was reset (false without an inherited value, without an own value, while disabled or readonly, or when the event was prevented).",
      "arguments": [],
      "returns": {
        "type": "boolean",
        "description": "Whether the field was reset."
      }
    }
  },
  "events": {
    "change": {
      "summary": "The value was committed; the native event bubbles from the inner textarea, which is its target.",
      "payload": {
        "type": "object"
      },
      "canonical": true
    },
    "input": {
      "summary": "The value changed while typing; the native event bubbles from the inner textarea, which is its target.",
      "payload": {
        "type": "object"
      }
    },
    "sf-field:reset": {
      "summary": "The person pressed the reset back to the inherited value. Fired before the field is emptied and cancellable: preventDefault keeps the value. When it is not prevented the field empties, says so with its ordinary change, shows the inherited value again and takes focus back.",
      "payload": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "The field's own value before the reset."
          },
          "inheritedValue": {
            "type": "string",
            "description": "The inherited value it returns to."
          },
          "name": {
            "type": "string",
            "description": "The form name, empty when the field has none."
          }
        }
      }
    }
  },
  "state": {
    "machines": {},
    "visual_states": [
      "default",
      "active",
      "disabled",
      "error"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "fixture",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "textbox",
    "accessible_name": "required",
    "keyboard": [
      "Tab",
      "native multiline text editing"
    ],
    "focus": "Keep visible focus on the active control. After a reset back to the inherited value, focus returns to the control; while the value is inherited, the control carries it as aria-description and the visible marker is aria-hidden."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "block",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
