          "name": "nextValue",
          "type": "boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setState": {
      "summary": "Applies keys: value goes through setValue, multiple fixes the handle count explicitly, disabled through setDisabled; any other key is written as its kebab-case attribute (false, null, undefined or empty removes it, true sets it empty).",
