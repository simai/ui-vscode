{
  "schema_version": 2,
  "id": "smart.icon-buttons",
  "version": "1.0.0",
  "title": "Icon Buttons",
  "summary": "Native icon-only action with token geometry, accessible naming and shared loading semantics.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "icon-buttons"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-icon-button",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.icon-buttons",
      "smart.icons",
      "smart.close",
      "component.spinner",
      "component.badges"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "kind": {
        "type": "string",
        "default": "icon",
        "enum": [
          "icon",
          "close"
        ],
        "description": "What the icon button is: an ordinary icon action or a close control."
      },
      "size": {
        "type": "string",
        "default": "1",
        "description": "Icon button size token.",
        "enum": [
          "1/3",
          "1/2",
          "1",
          "2",
          "3"
        ]
      },
      "appearance": {
        "type": "string",
        "default": "default",
        "description": "How the icon button looks. Surface and ghost read the neutral alpha ramp: surface keeps a faint fill and a border, ghost keeps nothing until it is hovered or focused.",
        "enum": [
          "default",
          "tonal",
          "outline",
          "link",
          "surface",
          "ghost"
        ]
      },
      "scheme": {
        "type": "string",
        "default": "primary",
        "description": "Which colour family the control takes. What the control is about is the status axis; a status set there wins over this.",
        "enum": [
          "primary",
          "secondary",
          "on-surface"
        ]
      },
      "status": {
        "type": "string",
        "default": "",
        "description": "What the control is about, in the shared status vocabulary. The only one a control paints today is `error`, the destructive one: a control that deletes, discards or cannot be undone.",
        "enum": [
          "",
          "error"
        ]
      },
      "segment": {
        "type": "string",
        "default": "",
        "description": "Joined-control position owned by Button Group composition.",
        "enum": [
          "",
          "start",
          "middle",
          "end"
        ]
      },
      "icon": {
        "type": "string",
        "default": "add",
        "description": "Material icon name."
      },
      "filled": {
        "type": "boolean",
        "default": false,
        "description": "Use the filled glyph axis for the standard icon variant."
      },
      "spacing": {
        "type": "string",
        "default": "normal",
        "description": "Semantic internal spacing profile.",
        "enum": [
          "compact",
          "normal",
          "comfortable",
          "spacious"
        ]
      },
      "tightness": {
        "type": "string",
        "default": "",
        "description": "Compatibility alias for spacing.",
        "enum": [
          "",
          "low",
          "high",
          "highest"
        ]
      },
      "radius": {
        "type": "string",
        "default": "",
        "description": "Border radius modifier.",
        "enum": [
          "",
          "default",
          "square",
          "rounded"
        ]
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Extra classes applied to the inner icon button element."
      },
      "loading": {
        "type": "boolean",
        "default": false,
        "description": "Loading state: the spinner in place of the icon, at the icon's size, in the page's look (data-sf-spinner). Sets aria-busy and disables the native button."
      },
      "disabled": {
        "type": "boolean",
        "default": false,
        "description": "Disabled state flag."
      },
      "native-type": {
        "type": "string",
        "default": "button",
        "description": "Native button type attribute.",
        "enum": [
          "button",
          "submit",
          "reset"
        ]
      },
      "aria-label": {
        "type": "string",
        "default": "",
        "description": "Accessible label."
      },
      "badge-count": {
        "type": "string",
        "default": "",
        "description": "A count on the icon button (simai/ui-source#12): a whole number above 0 shows, 0 or empty hides the badge. Above badge-cap it reads «<cap>+»; the exact number joins the icon button's accessible name («Уведомления, 5 непрочитанных») and the badge's tooltip. On an anchor of size 1/3 or 1/2 a count is drawn as a dot."
      },
      "badge-dot": {
        "type": "boolean",
        "default": false,
        "description": "A dot on the icon button, a count with no number: something new. Shown when badge-count is not set; with a count, the count is drawn as a dot. Its text equivalent («есть новое» / «new» by default, badge-label to change it) joins the accessible name."
      },
      "badge-cap": {
        "type": "integer",
        "default": 99,
        "description": "The largest count drawn as a number; a larger one reads «<cap>+»."
      },
      "badge-label": {
        "type": "string",
        "default": "",
        "description": "The words the badge adds to the accessible name and its tooltip, in place of the page language's default: for a dot the whole text equivalent; for a count the phrase in plural forms separated by «|» (one|few|many in Russian, one|other in English) with {count} where the number goes."
      },
      "variant": {
        "type": "string",
        "default": "icon",
        "description": "Legacy name for kind, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "icon",
          "close"
        ]
      },
      "type": {
        "type": "string",
        "default": "default",
        "description": "Legacy name for appearance, still honoured. See contracts/public-api-axes.json.",
        "enum": [
          "default",
          "tonal",
          "outline",
          "link",
          "surface",
          "ghost"
        ]
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "visual_pairings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "examples": [
        [
          {
            "type": "default",
            "schemes": [
              "primary",
              "on-surface"
            ]
          },
          {
            "type": "tonal",
            "schemes": [
              "secondary",
              "on-surface"
            ]
          },
          {
            "type": "outline",
            "schemes": [
              "primary",
              "on-surface"
            ]
          },
          {
            "type": "link",
            "schemes": [
              "primary",
              "on-surface"
            ]
          }
        ]
      ]
    },
    "interaction_states": {
      "type": "string",
      "enum": [
        "hover",
        "active"
      ]
    }
  },
  "methods": {
    "setButtonAttributes": {
      "summary": "Passes the object to setState() as buttonAttributes; the built-in template does not read it, so it only reaches an external project template. Returns the element.",
      "arguments": [
        {
          "name": "attributes",
          "type": "object",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onClick": {
      "summary": "Adds a listener for click on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onFocus": {
      "summary": "Adds a listener for focusin on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onBlur": {
      "summary": "Adds a listener for focusout on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onMouseEnter": {
      "summary": "Adds a listener for mouseenter on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "onMouseLeave": {
      "summary": "Adds a listener for mouseleave on the host. Returns the element.",
      "arguments": [
        {
          "name": "handler",
          "type": "function",
          "required": true
        },
        {
          "name": "options",
          "type": [
            "object",
            "boolean"
          ],
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setDisabled": {
      "summary": "Sets the disabled attribute when nextValue is truthy and removes it otherwise. Returns the element.",
      "arguments": [
        {
          "name": "nextValue",
          "type": "boolean",
          "required": false
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    }
  },
  "events": {},
  "state": {
    "machines": {},
    "visual_states": [
