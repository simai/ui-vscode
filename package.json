{
  "name": "sf-vscode",
  "displayName": "SIMAI Framework IntelliSense",
  "description": "Autocomplete and hovers for SIMAI Framework: sf- component tags and attributes, utility classes and --sf- design tokens with colour swatches and adaptive values.",
  "version": "0.1.0",
  "publisher": "SIMAI",
  "author": "Rim Zabarov and contributors",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/simai/ui-vscode#readme",
  "bugs": {
    "url": "https://github.com/simai/ui-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/simai/ui-vscode.git"
  },
  "keywords": [
    "SIMAI Framework",
    "SIMAI",
    "sf",
    "css variables",
    "design tokens",
    "utility classes",
    "web components",
    "intellisense",
    "autocomplete"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:less",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:vue",
    "onLanguage:react"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "SIMAI Framework IntelliSense",
      "properties": {
        "sf.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show SIMAI Framework hovers for --sf- tokens, utility classes, sf- tags and their attributes."
        },
        "sf.colorSwatches.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show colour swatches next to --sf- colour tokens. Picking a colour offers the nearest SIMAI Framework colour token."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "generate": "npm run compile && node ./out/generate/generateJson.js && node ./out/generate/generateFramework.js",
    "generate:check": "npm run compile && node ./out/generate/generateJson.js --check && node ./out/generate/generateFramework.js --check",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "clean": "rm -rf out",
    "test": "node --test ./out/test/*.unit.test.js",
    "test:extension": "npm run compile && node ./out/test/runTest.js",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "vscode:prepublish": "npm run clean && npm run compile",
    "package": "vsce package",
    "package:ls": "vsce ls",
    "vendor:framework": "npm run compile && node ./out/generate/vendorFramework.js",
    "package:check": "vsce ls | node ./out/generate/checkPackage.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.57.1",
    "glob": "^13.0.6",
    "globals": "^15.13.0",
    "mocha": "^12.0.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  }
}
